{
  "name": "pi-inmemory-mode",
  "version": "0.1.0",
  "private": true,
  "description": "Task-frozen document context and recoverable workspace branches for Pi",
  "license": "MIT",
  "author": "IntHelloWorld",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IntHelloWorld/pi-InMemoryMode.git"
  },
  "homepage": "https://github.com/IntHelloWorld/pi-InMemoryMode#readme",
  "bugs": {
    "url": "https://github.com/IntHelloWorld/pi-InMemoryMode/issues"
  },
  "type": "module",
  "keywords": ["pi-package", "pi-extension", "document-editing", "snapshots", "version-history"],
  "files": ["extension.ts", "src", "scripts", "README.md", "README.zh-CN.md", "LICENSE", "THIRD_PARTY_NOTICES.md", "CONTRIBUTING.md", "docs", "examples/documents"],
  "pi": {
    "extensions": ["./extension.ts"]
  },
  "scripts": {
    "setup:tree": "node scripts/setup-tree-host.mjs",
    "predev": "node scripts/setup-tree-host.mjs",
    "dev": "pi -e .",
    "check": "tsc --noEmit",
    "smoke": "node smoke.mjs",
    "pretest": "node scripts/setup-tree-host.mjs",
    "test": "node --test tests/*.test.ts"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "npm@11.19.1",
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-agent-core": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-agent-core": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@types/node": "22.19.19",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "typebox": "^1.3.27"
  }
}
